# Local demo: synthetic receipts, disposable wallets and a custom test token.
SOLANA_RPC_URL=http://127.0.0.1:8899
SOLANA_NETWORK=localnet
DEMO_MODE=true
PORT=5173
HOST=127.0.0.1
# Public wallet mode requires DEMO_MODE=false, SOLANA_NETWORK=devnet,
# HOST=0.0.0.0 and PUBLIC_ORIGIN=https://your-domain.example
# Set a verified devnet deployment and Circle's devnet USDC mint for wallet mode.
# PROGRAM_ID=
# TOKEN_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
